# Copy this file to `.env` and fill in real values for your environment.
# Never commit the real `.env` file.

ENVIRONMENT=development
DEBUG=true

# Comma-separated list of origins allowed to call this API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Async (asyncpg) URL — used by both the running app and Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saira
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- JWT ---------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Required by Authlib to persist OAuth state/nonce between redirect + callback.
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=change-me-to-a-different-long-random-string

# --- Frontend ----------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# --- Google OAuth --------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- ORCID OAuth ---------------------------------------------------------------
# https://orcid.org/developer-tools (or https://sandbox.orcid.org for testing)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:8000/api/v1/auth/orcid/callback
# sandbox | production
ORCID_ENVIRONMENT=sandbox
